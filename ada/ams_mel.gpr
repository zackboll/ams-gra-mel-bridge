with "ams_mel_c.gpr";

library project AMS_MEL is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Dir use "lib";
   for Library_Name use "ams_mel";
   for Library_Kind use "static";
   --  No Interfaces clause: this is not a standalone Ada library.

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;

   package Format is
      for Width ("Ada") use "100";
   end Format;
end AMS_MEL;
