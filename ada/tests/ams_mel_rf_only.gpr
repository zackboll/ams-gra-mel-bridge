with "ams_mel.gpr";

project AMS_MEL_RF_Only is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj-rf";
   for Exec_Dir use "bin";
   for Main use ("ams_mel_rf_smoke.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-Wl,--enable-new-dtags");
   end Linker;

   package Format is
      for Width ("Ada") use "100";
   end Format;
end AMS_MEL_RF_Only;
