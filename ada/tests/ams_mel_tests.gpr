with "ams_mel.gpr";

project AMS_MEL_Tests is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
    for Main use ("ams_mel_smoke.adb", "ams_mel_rf_pointing_focused.adb", "ams_mel_rf_interval_status.adb", "ams_mel_rf_job_extension.adb", "ams_mel_rf_va_queries.adb", "ams_mel_rf_va_notifications.adb", "ams_mel_rf_element_groups.adb", "ams_mel_rf_local_functions.adb", "ams_mel_rf_data_pipes.adb", "ams_mel_rf_transmit_power.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;

   --  The Ada binding links the production facade named by ams_mel_c.gpr.
   --  These contract tests, however, drive the test-only failpoints that only
   --  the contract-test facade in native/build-tests compiles in.  Emitting
   --  DT_RUNPATH instead of DT_RPATH lets LD_LIBRARY_PATH select that facade
   --  for this test executable without changing what the binding links.
   package Linker is
      for Default_Switches ("Ada") use ("-Wl,--enable-new-dtags");
   end Linker;

   package Format is
      for Width ("Ada") use "100";
   end Format;
end AMS_MEL_Tests;
