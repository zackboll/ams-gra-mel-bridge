with "ams_mel.gpr";

project AMS_MEL_Squall_RF_VA is
   Build_Dir := external ("AMS_MEL_SQUALL_ADA_BUILD_DIR", "../../build/squall");
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use Build_Dir & "/rf-va-ada-obj";
   for Exec_Dir use Build_Dir & "/bin";
   for Main use ("ams_mel_squall_rf_va.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;
end AMS_MEL_Squall_RF_VA;