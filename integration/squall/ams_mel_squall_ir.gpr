with "ams_mel.gpr";

project AMS_MEL_Squall_IR is
   Build_Dir := external ("AMS_MEL_SQUALL_ADA_BUILD_DIR", "../../build/squall");

   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use Build_Dir & "/ada-obj";
   for Exec_Dir use Build_Dir & "/bin";
   for Main use ("ams_mel_squall_ir.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatVa", "-gnatwa", "-gnatwe");
   end Compiler;
end AMS_MEL_Squall_IR;
